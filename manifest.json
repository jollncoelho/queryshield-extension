{
  "manifest_version": 3,
  "name": "QueryShield — Protection anti-arnaque",
  "short_name": "QueryShield",
  "version": "1.0.0",
  "description": "Analyse instantanee de SMS, e-mails et URLs suspects. Verifie les sites que vous visitez et vous alerte en cas de phishing.",
  "permissions": ["storage", "tabs", "notifications", "alarms"],
  "host_permissions": ["https://shield.query-intel.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QueryShield — analyser un message ou un site",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@query-intel.com",
      "strict_min_version": "109.0"
    }
  }
}
