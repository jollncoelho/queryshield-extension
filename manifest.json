{
  "manifest_version": 3,
  "name": "QueryShield — Bouclier anti-arnaque",
  "short_name": "QueryShield",
  "version": "2.1.0",
  "description": "Analyse zero-click des pages, detection des formulaires de harvesting, blocage actif des sites de phishing et console tactique.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://shield.query-intel.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QueryShield — console tactique",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html", "blocked/blocked.js", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@query-intel.com",
      "strict_min_version": "128.0"
    }
  }
}
